      "deckLimit": 2
    },
    {
      "id": 108,
      "name": "Tome of the Arcanis",
      "description": "Equipped champion with Class: Wizard, Race: Jellebrium, or Race: Firk gains <ability value=406>Teleport 1</ability>, <ability value=897>Mindwipe Aura 2</ability>, <ability value=1271>Tempo</ability> and <ability value=630>Grant: Flight</ability>.",
      "flavorText": "\"We found the book beside a felled Leoss, his body still embracing it. Inside were many theories on Arcane magic, most of them proven; theories we had never thought to explore. I had a messenger send it to Forglar, to give it to Gekaal. He would know what to do with it.\" - Berkchani, Ambassador to Seljichan",
      "noraCost": 30,
      "artist": "Jakub Kasper",
      "factions": [
        "Forglar Swamp"
      ],
      "rarity": "UNCOMMON",
      "runeSet": "Maljaran Frontier",
