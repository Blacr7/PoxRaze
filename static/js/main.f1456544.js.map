    {
      "id": 275,
      "name": "Sandspout",
      "description": "Area of Effect 3: This area becomes sand. At the end of your turns, all enemy champions within the area are <condition value=blinded>Blinded</condition> for 2 turns and all friendly champions become <condition value=stealthed>Stealthed</condition> for 4 turns, and the area of this spell's effect decreases by 1.",
      "flavorText": "\"Expansion. Invasion. These are the words our enemies use. We spread our kingdom into theirs, not because we hope to bury them. We bring immortality! The sand is eternity. We strive for an endless kingdom!\" - Derifos, Dunewalker Lord",
      "noraCost": 40,
      "artist": "Jakub Kasper",
      "factions": [
