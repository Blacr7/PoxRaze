    {
      "id": 119,
      "name": "Tempest Crown",
      "description": "Upon equipping to a champion, all enemy champions become <condition value=frightened>Frightened</condition> for 2 turns.  Equipped champion gains <ability value=107>Immortality</ability>. If it has Race: Lich, it also gains <ability value=2291>Lightning Storm 3</ability>. If it is Race: Voil, it gains <ability value=1330>Dread</ability> instead.",
      "flavorText": "The crown of the Voil King was buried with him, in his tomb. When word of his resurrection spread, many came to claim his crown for themselves. The crown and the king were gone.",
      "noraCost": 30,
      "artist": "James Ryman",
      "factions": [
        "Forsaken Wastes",
        "Shattered Peaks"
      ],
      "rarity": "RARE",
