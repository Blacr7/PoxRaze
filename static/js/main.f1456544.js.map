      "deckLimit": 2
    },
    {
      "id": 174,
      "name": "Execution Order",
      "description": "Area Effect 3: Friendly champions with a MAX RNG of 2 or less gain 2 AP, <ability value=6>Mobility</ability> and <ability value=684>Execute</ability> for 1 turn.",
      "flavorText": "Once the most feared order in Elsarin, this command brings a new zeal to Serkan's forces.",
      "noraCost": 35,
      "artist": "Matt Dixon",
      "factions": [
        "Forsaken Wastes"
      ],
      "rarity": "RARE",
