      "deckLimit": 2
    },
    {
      "id": 172,
      "name": "Myx Pupae",
      "description": "After 5 turns, this relic is destroyed and a Young Myx Drone with no upgrades is summoned in its place.",
      "flavorText": "With proper nurturing a Myx Drone Pupae can hatch in as little as 5 Days. If Pupae are in a hostile environment they will instinctively reduce hatching times drastically...at much cost to their lifespan.",
      "noraCost": 20,
      "artist": "Jakub Kasper",
      "factions": [
