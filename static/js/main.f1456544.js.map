      "deckLimit": 2
    },
    {
      "id": 78,
      "name": "Recall",
      "description": "Target real owned champion is removed from play and returned to the runedock. The next spell you cast costs 70% less nora.",
      "flavorText": "\"Don't take his criticisms too hard. The Garu don't understand that even if we use all our tricks, magic still takes time.\"- Elven Battlemages after Battle of Burning Fields",
