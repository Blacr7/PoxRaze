      "deckLimit": 2
    },
    {
      "id": 47,
      "name": "Skeezick Blade",
      "description": "Equipped champion gains <ability value=920>Skeezick Blade</ability> (This champion makes a Physical attack at RNG 1. If successfully damaged, the target becomes <condition value=eviscerated>Eviscerated</condition> for 3 turns and <condition value=inhibitied>Inhibitied</condition>). If champion has Race: Skeezick, it also gains <ability value=2198>Decapitating Blow</ability>.",
      "flavorText": "\"This blade is a gift from Rugolth himself,  Giblip. Be sure the Draksar Lord is looking in your eyes when you separate head from neck.\" - Dwarven Minister to the Skeezick General",
      "noraCost": 25,
      "artist": "Gabriel Garza",
      "factions": [
        "Sundered Lands"
      ],
      "rarity": "RARE",
