    {
      "id": 218,
      "name": "Fight in Formation",
      "description": "Area Effect 3: Draksar gain <ability value=1987>Hold the Line</ability> and <ability value=2471>Protective</ability> for 4 turns. If they have Hold the Line, they gain <ability value=1481>Shield Allies</ability> instead.",
      "flavorText": "The Draksar are taught, from an early age, to fight together. A soldier that strays from his unit is severely punished. No Draksar is exempt from this.",
      "noraCost": 30,
      "artist": "Jakub Kasper",
      "factions": [
