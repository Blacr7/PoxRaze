      "deckLimit": 2
    },
    {
      "id": 54,
      "name": "Smooth Stone",
      "description": "This champion gets +1 DEF and +1 SPD and gains <ability value=855>Hidden: Water</ability> and <ability value=6>Mobility</ability>.",
      "flavorText": "Throw a smooth stone across the water, and it will run upon it for a time. Infuse that stone with the spirit of the lake, and bathe it in nora, and it will allow you to do the same.",
