      "deckLimit": 2
    },
    {
      "id": 110,
      "name": "Shroud of Al'Mara",
      "description": "Equipped champion with Class: Priest or Shaman gains <ability value=1728>Divert</ability> and <ability value=592>Cleanse</ability>.",
      "flavorText": "\"She spent many hours praying in her shroud. I dared not disturb her. Later, she would tell me that she prayed for strength from Al'Mara and that her prayer sustained her in Maljara.\" - Thomroy, Priets of Ironfist",
      "noraCost": 25,
      "artist": "James Ryman",
      "factions": [
        "Ironfist Stronghold"
