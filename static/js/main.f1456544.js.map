      "deckLimit": 2
    },
    {
      "id": 298,
      "name": "Converging Portals",
      "description": "Area Effect 2: Champions in the affected area are all relocated to the same randomly selected nora font.",
      "flavorText": "With help from K'thiras, the Ironfist Magisters were able to develop their own techniques for teleportation. Soon, they could move several through separate portals and transport them to the same area with relative accuracy.",
      "noraCost": 35,
      "artist": "Jakub Kasper",
