    {
      "id": 255,
      "name": "Flash Freeze",
      "description": "Target champion gains <ability value=1295>Trail: Ice</ability>, becomes <condition value=crystallized>Crystallized</condition> for 2 turns and if it is an enemy champion, it also becomes <condition value=frozen>Frozen</condition> for 6 turns.",
      "flavorText": "\"We've slowed their advances to a halt. Our shardmasters made quick work of their Fiends. The rest were left at the pass, frozen to death.\" - Juya Whiteeyes",
      "noraCost": 35,
      "artist": "James Ryman",
      "factions": [
