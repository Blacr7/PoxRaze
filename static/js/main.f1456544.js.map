      "deckLimit": 2
    },
    {
      "id": 305,
      "name": "Healing Hand",
      "description": "For 6 turns, the next time this unit's HP would fall to 5 or less, this unit is healed to 50% of its max HP. This effect is hidden until triggered.",
      "flavorText": "\"The elf made a full recovery. The Priest's power was unbelievable; even Priestess Megin commented on his skill. Considering their predicament, these Leoss are truly amazing creatures.\" -Shardseer K'aeyun\r\n",
      "noraCost": 40,
      "artist": "James Ryman",
      "factions": [
