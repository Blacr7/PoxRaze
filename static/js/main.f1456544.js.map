      "deckLimit": 2
    },
    {
      "id": 98,
      "name": "Nefari Exchange",
      "description": "Relics and equipment you deploy receive a 10% nora refund. This effect does not stack. This relic has <ability value=1517>Train: Damage</ability> and <ability value=1515>Train: Healing Salve</ability>.",
      "flavorText": "\"You could just accept the shoddy blade that the Boks gave you. Or, you could purchase one of my fine scimitars. Of course, my expertise comes with a price.\" - Y`almi, Nefari Blacksmith",
      "noraCost": 20,
      "artist": "James Ryman",
      "factions": [
        "Underdepths"
      ],
      "rarity": "COMMON",
      "runeSet": "Ancient Awakenings",
