      "deckLimit": 2
    },
    {
      "id": 24,
      "name": "Nefari Torch",
      "description": "When a player successfully casts a spell, their enemy's champions gain +1 DMG for 6 turns and gain 1AP and their champions gain -1 DMG for 6 turns and lose 1AP. (Unique: Spell Seal - you may only have 2 Spell Seal runes in your Battlegroup)",
      "flavorText": "Fueled by the magical pyre-stone, the torches of the Underdepths burn with malevolent ferocity.",
      "noraCost": 25,
      "artist": "Layne Johnson",
      "factions": [
