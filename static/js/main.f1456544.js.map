      "forSale": true,
      "allowRanked": true,
      "tradeable": true,
      "hash": "ej9Ej9De9Be9Ae9Bg3AJ8GJ8Hiwinpnlgkpsfxo",
      "deckLimit": 2
    },
    {
      "id": 262,
      "name": "Extended Reach",
      "description": "All friendly champions with a minimum range of 1 have their maximum range increased by 1 until the end of turn.",
      "flavorText": "\"I know the weapon won't work. But, look how it's made. I think that one has caught on to something, Roogiid.\" - Haadrim, Military Advisor to Queen Eehiist.",
      "noraCost": 20,
      "artist": "Matt Dixon",
      "factions": [
        "Shattered Peaks"
      ],
      "rarity": "COMMON",
      "cooldown": 4,
